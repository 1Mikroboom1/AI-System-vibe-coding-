{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "noEmit": false,
    "outDir": "./dist/server",
    "skipLibCheck": true,
    "noUnusedParameters": false,
    "types": ["node"]
  },
  "include": ["src/server/**/*"]
}
